[Unit]
Description=CM6206 Web Control API
Requires=cm6206-setup.service
After=cm6206-setup.service
[Service]
Type=simple
User=cm6206-web
Group=audio
WorkingDirectory=/opt/cm6206-web
RuntimeDirectory=cm6206-web
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=no
ExecStart=/opt/cm6206-web/venv/bin/gunicorn --workers 1 --bind 0.0.0.0:80 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=1
[Install]
WantedBy=multi-user.target
